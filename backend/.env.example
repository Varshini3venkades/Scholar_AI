# ScholarMatch AI Backend Environment Variables

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Server-only service role key (Never expose to client/frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Authentication mode:
# 'strict' enforces verified Supabase JWTs on private endpoints.
# 'dev' allows test headers (e.g. x-demo-user-id) if testing locally before Auth setup.
AUTH_MODE=dev
